{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "baseUrl": "src",
    "paths": {
      "@components/*": ["../src/components/*"],
      "@navigation/*": ["../src/navigation/*"],
      "@theme/*": ["./src/theme/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "images.d.ts"] // Adjust as needed
  
}
